{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2017",
    "types": ["node"],
    "lib": ["es2017"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true
  },
  "references": [
    {
      "path": "./tsconfig.tests.json"
    },
    {
      "path": "./tsconfig.src.json"
    }
  ],
  "files": []
}
